{
  "rules": {
    "games": {
      ".read": true,
      "$gameId": {
        ".write": true,
        "characters": {
          "$charId": {
            ".validate": "newData.hasChildren(['playerName', 'characterName', 'role'])"
          }
        },
        "rolls": {
          "$rollId": {
            ".validate": "newData.hasChildren(['playerName', 'dice', 'result', 'timestamp'])"
          }
        }
      }
    },
    "activeGameId": {
      ".read": true,
      ".write": true
    }
  }
}
